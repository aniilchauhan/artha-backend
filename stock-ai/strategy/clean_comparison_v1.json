{
  "version": "clean-comparison-v1",
  "target_version": "daily-open-fill-stop-first-v1",
  "feature_version": "clean-price-market-v1",
  "scope": "historical_research_only",
  "universe": "core50_frozen_at_run_creation",
  "target_pct": 0.02,
  "stop_pct": 0.02,
  "roundtrip_fee": 0.001,
  "slippage_per_side": 0.0005,
  "cost_stress_multiplier": 2.0,
  "gap_rejection": "none; unconditional opening-entry research approximation",
  "intraday_resolution": "stop_first_if_both_touched; otherwise_target_or_session_close",
  "min_fit_sessions": 504,
  "early_stop_sessions": 126,
  "calibration_sessions": 126,
  "policy_sessions": 63,
  "evaluation_sessions": 126,
  "max_folds": 3,
  "min_rows_per_partition": 200,
  "min_class_count": 10,
  "max_positions_per_day": 5,
  "coverage_fraction": 0.2,
  "tie_break": "ticker_ascending; ties_reported; ranking_is_not_a_trade_recommendation",
  "policy_quantiles": [0.5, 0.7, 0.9],
  "min_policy_trades": 50,
  "calibration_method": "sigmoid",
  "bootstrap_block_sessions": 10,
  "bootstrap_repeats": 500,
  "seed": 42,
  "lightgbm": {"n_estimators": 250, "learning_rate": 0.03, "num_leaves": 15, "max_depth": 4, "min_child_samples": 100, "reg_lambda": 1.0, "verbosity": -1, "n_jobs": 2, "random_state": 42},
  "limitations": [
    "Daily OHLC cannot reveal intraday ordering; conservative target labels are a modeling approximation.",
    "Costs are declared research assumptions, not a current verified broker fee schedule.",
    "Current core50 membership has survivor-selection bias; historical membership is not established.",
    "Cached prices have no independently verified retrieval/adjustment provenance; no production eligibility is conferred.",
    "All historical evaluation is research; new prospective sessions are needed before any accuracy claim."
  ]
}
